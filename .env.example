# Copy to .env and edit (make setup does). scripts/*.sh read it; values already set in your shell win.

# --- model under test (any OpenAI-compatible chat-completions endpoint with tool calls) ---
# Local llama.cpp / vLLM / Ollama:
MODEL_BASE_URL=http://127.0.0.1:8091/v1
MODEL_NAME=local
MODEL_API_KEY_VAR=LOCAL_API_KEY
LOCAL_API_KEY=none
# API model instead (examples; set the key in your shell, not here):
# MODEL_BASE_URL=https://api.openai.com/v1      MODEL_NAME=gpt-5.2       MODEL_API_KEY_VAR=OPENAI_API_KEY
# MODEL_BASE_URL=https://openrouter.ai/api/v1   MODEL_NAME=qwen/qwen3-8b MODEL_API_KEY_VAR=OPENROUTER_API_KEY
# MODEL_BASE_URL=https://api.pinference.ai/api/v1 (Prime Inference) MODEL_API_KEY_VAR=PRIME_API_KEY

# --- local server (scripts/serve_local.sh) ---
LLAMA_SERVER=llama-server            # path to llama.cpp's llama-server (SYCL, Vulkan or CPU build)
GGUF=models/qwen2.5-3b-instruct-q4_k_m.gguf
LLAMA_PORT=8091
LLAMA_CTX=8192
# Intel Arc via SYCL (llama.cpp docs/backend/SYCL.md):
ONEAPI_SETVARS=/opt/intel/oneapi/setvars.sh
ONEAPI_DEVICE_SELECTOR=level_zero:0
ZES_ENABLE_SYSMAN=1

# --- eval size ---
N=8                 # tasks
SEED_OFFSET=1000    # 1000 = held-out seeds, 0 = training seeds
MAX_TURNS=80

# --- rendering ---
MUJOCO_GL=egl       # egl (GPU Mesa driver) | osmesa (CPU)
